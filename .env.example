# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_USERNAME=sa
DB_PASSWORD=your_secure_password_here

# Default User Configuration
# These values are used to create a default user when the application starts
APP_USUARIO_PADRAO_NOME=Default User Name
APP_USUARIO_PADRAO_EMAIL=default.user@example.com
APP_USUARIO_PADRAO_PASSWORD=your_secure_default_password

# AI Provider Configuration
AI_PROVIDER=openai

# API Keys - NEVER commit these values to git
# Get your API keys from the respective platforms:
# - OpenAI: https://platform.openai.com/api-keys
# - xAI: https://console.x.ai/

AI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Application Settings
SPRING_PROFILES_ACTIVE=development

