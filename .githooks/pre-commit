#!/bin/bash
# Pre-commit hook to prevent committing sensitive data
# Install with: chmod +x .githooks/pre-commit && git config core.hooksPath .githooks

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo -e "${GREEN}[PRE-COMMIT HOOK] Checking for secrets...${NC}"

# Array of patterns to check
PATTERNS=(
    "xai_api_key"
    "XAI_API_KEY"
    "xai-api-key"
    "grok.api.key"
    "grok_api_key"
    "GROK_API_KEY"
    "openai_api_key"
    "OPENAI_API_KEY"
    "sk-"
    "\.env$"
    "application-local"
    "application-prod"
    "\.pem$"
    "BEGIN RSA PRIVATE KEY"
    "BEGIN PRIVATE KEY"
    "-----BEGIN OPENSSH PRIVATE KEY"
)

FOUND_SECRETS=0

# Check each pattern
for pattern in "${PATTERNS[@]}"; do
    if git diff --cached -U0 | grep -i "$pattern" > /dev/null 2>&1; then
        echo -e "${RED}❌ DETECTED: Pattern '$pattern' found in staged changes${NC}"
        FOUND_SECRETS=1
    fi
done

# Check for .env files
if git diff --cached --name-only | grep -E "\.env|application-(prod|local|staging)\.properties" > /dev/null 2>&1; then
    echo -e "${RED}❌ DETECTED: Sensitive configuration file in staged changes${NC}"
    echo "Files:"
    git diff --cached --name-only | grep -E "\.env|application-(prod|local|staging)\.properties" | sed 's/^/   /'
    FOUND_SECRETS=1
fi

# Check for private keys
if git diff --cached -U0 | grep -E "BEGIN (RSA |OPENSSH )?PRIVATE KEY|PRIVATE KEY|private_key" > /dev/null 2>&1; then
    echo -e "${RED}❌ DETECTED: Private key in staged changes${NC}"
    FOUND_SECRETS=1
fi

if [ $FOUND_SECRETS -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}⚠️  COMMIT BLOCKED: Possible secrets detected${NC}"
    echo ""
    echo "To fix this:"
    echo "  1. Remove the sensitive data from the files"
    echo "  2. Use environment variables instead (see SECURITY.md)"
    echo "  3. Stage the corrected files"
    echo "  4. Try committing again"
    echo ""
    echo "If you believe this is a false positive:"
    echo "  Bypass with: git commit --no-verify"
    echo "  (NOT recommended - use with caution)"
    echo ""
    exit 1
fi

echo -e "${GREEN}✓ No secrets detected${NC}"
exit 0

